def solution(sizes):
    max_w = 0 
    max_h = 0 
    
    for w, h in sizes:
        # 현재 명함의 긴 변과 짧은 변을 구하기
        long_side = max(w, h)
        short_side = min(w, h)
        
        # 각각의 최댓값을 갱신
        max_w = max(max_w, long_side)
        max_h = max(max_h, short_side)
        
    return max_w * max_h
