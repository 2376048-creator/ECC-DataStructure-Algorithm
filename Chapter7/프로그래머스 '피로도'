from itertools import permutations

def solution(k, dungeons):
    max_count = 0
    
    # 던전들을 방문할 수 있는 모든 순서 구하기
    for order in permutations(dungeons, len(dungeons)):
        current_k = k 
        count = 0     
        
        # 정해진 순서대로 던전 탐험 
        for min_required, consume in order:
            if current_k >= min_required:  
                current_k -= consume       # 피로도 소모
                count += 1                
            else:
                break
                
        # 최댓값 갱신
        max_count = max(max_count, count)
        
        # 만약 모든 던전을 다 돌 수 있는 경우를 찾았다면 더 이상 계산할 필요 없음
        if max_count == len(dungeons):
            break
            
    return max_count
