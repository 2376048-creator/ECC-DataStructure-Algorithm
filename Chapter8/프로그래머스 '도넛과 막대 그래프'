def solution(edges):
    # 각 정점의 번호 중 가장 큰 값을 찾아 배열 크기를 지정
    max_node = 0
    for u, v in edges:
        max_node = max(max_node, u, v)
        
    # 진입차수, 진출차수 배열 초기화 (1번부터 사용하기 위해 +1)
    in_degree = [0] * (max_node + 1)
    out_degree = [0] * (max_node + 1)
    
    # 간선 정보를 바탕으로 차수 기록
    for u, v in edges:
        out_degree[u] += 1
        in_degree[v] += 1
        
    created_node = -1
    stick_count = 0
    eight_count = 0
    
    # 각 정점의 차수 확인
    for i in range(1, max_node + 1):
        # 간선이 없는(사용되지 않는) 정점 번호는 패스
        if in_degree[i] == 0 and out_degree[i] == 0:
            continue
            
        # 생성된 정점: 들어오는 건 없고 나가는 게 2개 이상
        if in_degree[i] == 0 and out_degree[i] >= 2:
            created_node = i
        # 막대 모양 그래프: 나가는 간선이 없는 끝점이 존재
        elif out_degree[i] == 0:
            stick_count += 1
        # 8자 모양 그래프: 나가는 간선이 2개인 중심점이 존재 (생성된 정점은 위에서 걸러짐)
        elif out_degree[i] >= 2:
            eight_count += 1
            
    # 도넛 모양 그래프: (전체 그래프 수) - (막대 개수) - (8자 개수)
    total_graphs = out_degree[created_node]
    donut_count = total_graphs - stick_count - eight_count
    
    return [created_node, donut_count, stick_count, eight_count]
